<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>a7e74d2d-e319-4b79-a89d-5d5f22b6fd37</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internal helpers (MediaUrlExtractor / MediaRefetch) to the test project. -->
    <InternalsVisibleTo Include="LineHfBot.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Line.OpenApi.Bot" Version="1.0.0" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.79.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.HuggingFace" Version="1.79.0-preview" />
  </ItemGroup>

  <ItemGroup>
    <!-- Rich menu images, uploaded to LINE at startup. Copied to output so publish/Docker carries them. -->
    <Content Include="Assets\richmenu\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
