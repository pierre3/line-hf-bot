# Copy to .env and fill in your values. NEVER commit .env.
# Used by docker compose (injected as environment variables).

# --- LINE Messaging API channel ---
Line__ChannelSecret=
Line__ChannelAccessToken=

# --- Hugging Face (token with "Inference Providers" permission) ---
HuggingFace__ApiKey=
HuggingFace__ChatModel=meta-llama/Llama-3.1-8B-Instruct
HuggingFace__ChatEndpoint=https://router.huggingface.co
HuggingFace__ImageModel=black-forest-labs/FLUX.1-schnell
HuggingFace__VideoModel=Wan-AI/Wan2.2-TI2V-5B

# --- Public base URL for generated media (your tunnel). HTTPS required by LINE. ---
App__PublicBaseUrl=
App__MediaTtlMinutes=10

# --- Optional tuning ---
Queue__Capacity=100
Queue__Workers=2
Chat__MaxHistory=20
