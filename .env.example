# Copy to .env and fill in your values. NEVER commit .env.
# Used by docker compose (injected as environment variables).

# --- LINE Messaging API channel ---
Line__ChannelSecret=
Line__ChannelAccessToken=
# Constraints for downloading user-sent images (to edit them). Defaults shown.
Line__MaxIncomingImageBytes=10485760
Line__ContentFetchTimeoutSeconds=30

# --- Hugging Face (token with "Inference Providers" permission) ---
HuggingFace__ApiKey=
# Default is a non-gated model. Gated models (e.g. meta-llama/*) require accepting the license on Hugging Face first.
HuggingFace__ChatModel=Qwen/Qwen2.5-7B-Instruct
HuggingFace__ChatEndpoint=https://router.huggingface.co
HuggingFace__ImageModel=stabilityai/stable-diffusion-3-medium-diffusers
# {model} is replaced with ImageModel. Image support is provider-dependent; adjust if needed.
HuggingFace__ImageEndpoint=https://router.huggingface.co/hf-inference/models/{model}
# Image editing (✏️ button / sent photos) = image-to-image via the fal-ai provider (async queue on the
# HF router). hf-inference does NOT serve image-to-image. Both providers draw down your HF Inference
# credits (free monthly allowance); fal-ai just costs more per call, so editing burns credits faster.
# {model} is the fal provider model id.
HuggingFace__ImageEditModel=fal-ai/qwen-image-edit
HuggingFace__ImageEditEndpoint=https://router.huggingface.co/fal-ai/{model}?_subdomain=queue
# Text-to-video (/video) = fal-ai provider (async queue on the HF router). hf-inference does NOT serve
# text-to-video. fal-ai costs more credits per call than hf-inference and video is heavier/slower than
# images, so it burns HF Inference credits fast. {model} is the fal provider model id.
HuggingFace__VideoModel=fal-ai/wan/v2.2-5b/text-to-video
HuggingFace__VideoEndpoint=https://router.huggingface.co/fal-ai/{model}?_subdomain=queue
# Image-to-video (🎬 button on images / sent photos) = fal-ai provider (async queue on the HF router,
# same as text-to-video). hf-inference does NOT serve image-to-video. A14B is larger than the text-to-video
# 5B default, so it costs more credits per call; a lighter alternative is "fal-ai/wan-i2v" (Wan2.1). Gated by
# the same App__VideoEnabled flag. {model} is the fal provider model id.
HuggingFace__ImageToVideoModel=fal-ai/wan/v2.2-a14b/image-to-video
HuggingFace__ImageToVideoEndpoint=https://router.huggingface.co/fal-ai/{model}?_subdomain=queue
# Image question answering (vision/VQA) for sent photos: a vision-capable chat model on the OpenAI-compatible
# chat completions endpoint (same HF Inference credits as chat, NOT the credit-heavy fal provider).
# Pin the provider explicitly ("model:provider") and enable that provider in your HF settings
# (https://huggingface.co/settings/inference-providers). Without a pin, auto-routing may return
# model_not_supported; if the provider is at capacity you get a 503 (try another provider/model).
# The default (Qwen2.5-VL-72B on ovhcloud) needs ovhcloud enabled; alternatives: zai-org/GLM-4.5V:novita,
# google/gemma-3-27b-it:deepinfra. Unlike ChatEndpoint, VisionEndpoint is called directly so it MUST
# include the /v1/chat/completions path.
HuggingFace__VisionModel=Qwen/Qwen2.5-VL-72B-Instruct:ovhcloud
HuggingFace__VisionEndpoint=https://router.huggingface.co/v1/chat/completions
# Hosts allowed when re-fetching media from a provider URL (JSON-URL responses), image + video.
# Separated by ";"/","/whitespace; label-boundary match (fal.media allows cdn.fal.media, not evilfal.media). Empty = deny all.
HuggingFace__MediaRefetchAllowedHosts=fal.media;replicate.delivery

# --- Public base URL for generated media (your tunnel). HTTPS required by LINE. ---
App__PublicBaseUrl=
App__MediaTtlMinutes=10
# Video is off by default: fal video (text-to-video AND image-to-video) is credit-heavy and slow. This one
# flag gates the /video command, the 🎬 animate button, and image-to-video. Set true to enable once your HF
# token has Inference Providers credits to spare (see HuggingFace__VideoModel/ImageToVideoModel above).
App__VideoEnabled=false
# Image question answering (vision/VQA) on sent photos. On by default (uses chat-level HF credits, not fal).
# When on, sending a photo offers "Edit"/"Ask about this image"; when off, a sent photo goes straight to
# the edit flow and no vision UI is shown. Set false to disable (or if your token can't serve VisionModel).
App__VisionEnabled=true
# UI language for user-facing text and the rich menu ("en" default, or "ja").
App__Locale=en
# Provision the mode-switcher rich menu on startup (idempotent). Set false to run without a rich menu.
App__RichMenuEnabled=true

# --- Optional tuning ---
# Host port to expose the app on (change if 8080 is already in use). The tunnel uses this port too.
HOST_PORT=8080
HuggingFace__ChatTimeoutSeconds=60
HuggingFace__ImageTimeoutSeconds=120
HuggingFace__ImageEditTimeoutSeconds=120
HuggingFace__VideoTimeoutSeconds=300
HuggingFace__VisionTimeoutSeconds=120
Queue__Capacity=100
Queue__Workers=2
Chat__MaxHistory=20
