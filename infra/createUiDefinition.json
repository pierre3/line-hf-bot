{
  "$schema": "https://schema.management.azure.com/schemas/0.1.1-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "basics": [
      {
        "name": "appName",
        "type": "Microsoft.Common.TextBox",
        "label": "App name",
        "defaultValue": "line-hf-bot",
        "toolTip": "Name for the Container App. Also the basis for its public hostname.",
        "constraints": {
          "required": true,
          "regex": "^[a-z][a-z0-9-]{0,30}[a-z0-9]$",
          "validationMessage": "2-32 chars: lowercase letters, numbers, and hyphens; must start with a letter and not end with a hyphen."
        },
        "visible": true
      }
    ],
    "steps": [
      {
        "name": "line",
        "label": "LINE credentials",
        "elements": [
          {
            "name": "lineInfo",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Info",
              "text": "Get these from your Messaging API channel in the LINE Developers console (developers.line.biz).",
              "uri": "https://developers.line.biz/console/"
            }
          },
          {
            "name": "lineChannelSecret",
            "type": "Microsoft.Common.PasswordBox",
            "label": {
              "password": "Channel secret"
            },
            "toolTip": "LINE Messaging API channel secret.",
            "constraints": {
              "required": true
            },
            "options": {
              "hideConfirmation": true
            },
            "visible": true
          },
          {
            "name": "lineChannelAccessToken",
            "type": "Microsoft.Common.PasswordBox",
            "label": {
              "password": "Channel access token"
            },
            "toolTip": "LINE Messaging API long-lived channel access token.",
            "constraints": {
              "required": true
            },
            "options": {
              "hideConfirmation": true
            },
            "visible": true
          }
        ]
      },
      {
        "name": "huggingface",
        "label": "Hugging Face",
        "elements": [
          {
            "name": "hfInfo",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Info",
              "text": "Create a token with Inference Providers permission at huggingface.co/settings/tokens.",
              "uri": "https://huggingface.co/settings/tokens"
            }
          },
          {
            "name": "huggingFaceApiKey",
            "type": "Microsoft.Common.PasswordBox",
            "label": {
              "password": "Access token"
            },
            "toolTip": "Hugging Face access token (starts with hf_).",
            "constraints": {
              "required": true
            },
            "options": {
              "hideConfirmation": true
            },
            "visible": true
          },
          {
            "name": "chatModelInfo",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Info",
              "text": "The chat model must be served by a provider you have enabled, and provider catalogs change over time. If chat later fails, list current models: GET https://router.huggingface.co/v1/models",
              "uri": "https://huggingface.co/settings/inference-providers"
            }
          },
          {
            "name": "chatModel",
            "type": "Microsoft.Common.TextBox",
            "label": "Chat model",
            "defaultValue": "Qwen/Qwen2.5-72B-Instruct",
            "toolTip": "Hugging Face chat model id. Pin a provider as model:provider if needed. Lighter options: meta-llama/Llama-3.1-8B-Instruct, Qwen/Qwen3-4B-Instruct-2507.",
            "constraints": {
              "required": true,
              "regex": "^[^\\s]+$",
              "validationMessage": "Enter a model id with no spaces, e.g. Qwen/Qwen2.5-72B-Instruct or model:provider."
            },
            "visible": true
          }
        ]
      },
      {
        "name": "options",
        "label": "Options",
        "elements": [
          {
            "name": "locale",
            "type": "Microsoft.Common.DropDown",
            "label": "Language",
            "defaultValue": "English",
            "toolTip": "Language for user-facing text and the rich menu.",
            "constraints": {
              "allowedValues": [
                {
                  "label": "English",
                  "value": "en"
                },
                {
                  "label": "日本語 (Japanese)",
                  "value": "ja"
                }
              ],
              "required": true
            },
            "visible": true
          },
          {
            "name": "visionEnabled",
            "type": "Microsoft.Common.DropDown",
            "label": "Vision Q&A on photos",
            "defaultValue": "Enabled",
            "toolTip": "Ask questions about sent photos and generated images. Uses chat-level HF credits (light).",
            "constraints": {
              "allowedValues": [
                {
                  "label": "Enabled",
                  "value": true
                },
                {
                  "label": "Disabled",
                  "value": false
                }
              ],
              "required": true
            },
            "visible": true
          },
          {
            "name": "videoEnabled",
            "type": "Microsoft.Common.DropDown",
            "label": "Video generation",
            "defaultValue": "Disabled",
            "toolTip": "Enables /video (text-to-video) and Make a video (image-to-video). Both run on the credit-heavy, slow fal-ai provider, so this is off by default.",
            "constraints": {
              "allowedValues": [
                {
                  "label": "Disabled",
                  "value": false
                },
                {
                  "label": "Enabled",
                  "value": true
                }
              ],
              "required": true
            },
            "visible": true
          },
          {
            "name": "sizingInfo",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Info",
              "text": "The app runs as a single always-on replica (required by its in-memory state), so it is billed 24/7. The defaults (0.5 vCPU / 1.0 GiB) are enough for personal use."
            }
          },
          {
            "name": "size",
            "type": "Microsoft.Common.DropDown",
            "label": "Container size (vCPU / memory)",
            "defaultValue": "0.5 vCPU / 1.0 GiB",
            "toolTip": "ACA Consumption allows only fixed vCPU/memory pairs, so pick a combined size. The default is enough for personal use.",
            "constraints": {
              "allowedValues": [
                { "label": "0.25 vCPU / 0.5 GiB", "value": { "cpu": "0.25", "memory": "0.5Gi" } },
                { "label": "0.5 vCPU / 1.0 GiB", "value": { "cpu": "0.5", "memory": "1.0Gi" } },
                { "label": "0.75 vCPU / 1.5 GiB", "value": { "cpu": "0.75", "memory": "1.5Gi" } },
                { "label": "1.0 vCPU / 2.0 GiB", "value": { "cpu": "1.0", "memory": "2.0Gi" } },
                { "label": "1.25 vCPU / 2.5 GiB", "value": { "cpu": "1.25", "memory": "2.5Gi" } },
                { "label": "1.5 vCPU / 3.0 GiB", "value": { "cpu": "1.5", "memory": "3.0Gi" } },
                { "label": "1.75 vCPU / 3.5 GiB", "value": { "cpu": "1.75", "memory": "3.5Gi" } },
                { "label": "2.0 vCPU / 4.0 GiB", "value": { "cpu": "2.0", "memory": "4.0Gi" } }
              ],
              "required": true
            },
            "visible": true
          },
          {
            "name": "image",
            "type": "Microsoft.Common.TextBox",
            "label": "Container image",
            "defaultValue": "docker.io/pierre3/line-hf-bot:latest",
            "toolTip": "Container image to run. Use a pinned tag (e.g. :1.0.0) for reproducible deploys.",
            "constraints": {
              "required": true
            },
            "visible": true
          }
        ]
      }
    ],
    "outputs": {
      "location": "[location()]",
      "appName": "[basics('appName')]",
      "lineChannelSecret": "[steps('line').lineChannelSecret]",
      "lineChannelAccessToken": "[steps('line').lineChannelAccessToken]",
      "huggingFaceApiKey": "[steps('huggingface').huggingFaceApiKey]",
      "chatModel": "[steps('huggingface').chatModel]",
      "locale": "[steps('options').locale]",
      "visionEnabled": "[steps('options').visionEnabled]",
      "videoEnabled": "[steps('options').videoEnabled]",
      "cpu": "[steps('options').size.cpu]",
      "memory": "[steps('options').size.memory]",
      "image": "[steps('options').image]"
    }
  }
}
